---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../utils/url';
import '../../styles/case-study.css';

// One page per Markdown file in src/content/work/
export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { title, summary, org, context } = entry.data;
const { Content } = await render(entry);
---

<Base title={`${title} | Veronica Romero`} description={summary}>
  <!-- The whole case study sits on one calm background so the writing leads -->
  <article class="section--paper cs">
    <header class="cs-hero">
      <div class="container flow" style="--flow-space: var(--space-5)">
        <p><a class="cs-back" href={url('work/')}>All work</a></p>
        <p class="label">{org}, {context}</p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
    </header>

    <Content />

    <nav class="cs-next" aria-label="Next case study">
      <div class="container flow" style="--flow-space: var(--space-2)">
        <p class="label">Next case study</p>
        <p class="cs-next__title">
          <a href={url(`work/${next.id}/`)}>{next.data.title}</a>
        </p>
      </div>
    </nav>
  </article>
</Base>

<style>
  .cs-hero {
    padding-top: clamp(var(--space-7), 8vw, var(--space-9));
    padding-bottom: var(--space-6);
  }

  .cs-hero h1 {
    font-size: var(--text-2xl);
    max-width: 22ch;
  }

  .cs-back {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--ink);
  }

  .cs-next {
    padding-block: var(--space-8);
  }

  .cs-next .container {
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .cs-next__title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    --link-color: var(--blue);
  }
</style>
