---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactLinks from '../components/ContactLinks.astro';

// Placeholder illustrations. Replaced with the real paintings in milestone 5.
import Leaf from '../assets/illustrations/leaf.svg';
import Petal from '../assets/illustrations/petal.svg';
import Dots from '../assets/illustrations/dots.svg';

// Matter of fact and outcome driven
const problems = [
  {
    title: 'Strategic partnership with leadership.',
    body: 'Partnering with leaders on priorities and roadmaps, and running the operating cadence that keeps the team on track against them.',
  },
  {
    title: 'Building and scaling operations.',
    body: 'Standing up ops practices and growing them with the team, so workflows, tools, and resourcing keep pace with the work.',
  },
  {
    title: 'Career frameworks and performance.',
    body: 'Building progression frameworks that give managers and their teams a clear, shared basis for growth and performance conversations.',
  },
  {
    title: 'Quality standards.',
    body: 'Defining what good work looks like and building it into the project lifecycle, so quality is visible and measurable.',
  },
  {
    title: 'AI fluency and adoption.',
    body: 'Running learning programs that move teams from experimenting with AI to using it confidently in their day-to-day work.',
  },
  {
    title: 'Team culture and engagement.',
    body: 'Designing the rituals, onboarding, and recognition that keep people engaged and connected as teams change and grow.',
  },
];

const work = (await getCollection('work'))
  .filter((entry) => entry.data.onHomepage)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Veronica Romero: design operations and people experience leader"
  description="I help organizations build the systems and processes that let their people do their best work."
  footerContact={false}
>
  <section class="section section--teal hero" aria-labelledby="hero-name">
    <Leaf class="hero__art hero__art--leaf" aria-hidden="true" />
    <Petal class="hero__art hero__art--petal" aria-hidden="true" />
    <Dots class="hero__art hero__art--dots" aria-hidden="true" />
    <div class="container flow hero__inner" style="--flow-space: var(--space-6)">
      <hgroup class="hero__title">
        <h1 id="hero-name">Veronica Romero</h1>
        <p class="hero__role">Design operations and people experience leader</p>
      </hgroup>
      <p class="hero__intro">
        I help organizations build the systems and processes that let their people do their
        best work. I partner with leadership to set priorities, then turn them into programs
        teams actually use, from career frameworks and quality standards to AI fluency and team
        rituals.
      </p>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="problems-heading">
    <div class="container flow" style="--flow-space: var(--space-7)">
      <h2 id="problems-heading">Problems I help organizations solve</h2>
      <ul class="problems" role="list">
        {
          problems.map((problem) => (
            <li>
              <strong>{problem.title}</strong> {problem.body}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="section section--paper" aria-labelledby="work-heading">
    <div class="container flow" style="--flow-space: var(--space-6)">
      <h2 id="work-heading">Selected work</h2>
      <div class="work-grid">
        {
          work.map((entry) => (
            <WorkCard
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              org={entry.data.org}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section id="contact" class="section section--mist" aria-labelledby="contact-heading">
    <div class="container flow" style="--flow-space: var(--space-5)">
      <h2 id="contact-heading">Let's talk</h2>
      <p class="lede">
        If you'd like to work together, or you're wrestling with something on your team and
        want a second brain on it, I'd love to chat. Email is the best way to reach me.
      </p>
      <ContactLinks />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-8), 12vw, 10rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Name very big, with the label tucked in close underneath */
  .hero__title {
    display: grid;
    gap: var(--space-3);
  }

  .hero__title h1 {
    font-size: clamp(3rem, 0.6rem + 10vw, 9rem);
    font-weight: var(--weight-extralight);
    line-height: 1;
  }

  .hero__role {
    font-size: clamp(0.875rem, 0.6rem + 1.1vw, 1.5rem);
    font-weight: var(--weight-regular);
    line-height: var(--leading-snug);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mist);
    text-wrap: balance;
  }

  .hero__intro {
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    line-height: var(--leading-snug);
    max-width: 42ch;
  }

  /* Illustrations sit at the edges, slightly off the page, as if placed by hand */
  .hero :global(.hero__art) {
    position: absolute;
    pointer-events: none;
  }

  .hero :global(.hero__art--leaf) {
    width: clamp(5rem, 12vw, 9rem);
    top: -1.5rem;
    right: 6%;
    transform: rotate(24deg);
  }

  .hero :global(.hero__art--petal) {
    width: clamp(6rem, 14vw, 11rem);
    bottom: -2.5rem;
    right: -1.5rem;
    transform: rotate(-12deg);
  }

  .hero :global(.hero__art--dots) {
    width: clamp(5rem, 10vw, 8rem);
    bottom: 1.5rem;
    right: 28%;
  }

  /* On phones, keep only the corner pieces, small enough to stay clear of the text */
  @media (max-width: 40rem) {
    .hero :global(.hero__art--dots) {
      display: none;
    }

    .hero :global(.hero__art--leaf) {
      width: 3.5rem;
      top: -1rem;
      right: 1rem;
    }

    .hero :global(.hero__art--petal) {
      width: 5rem;
      bottom: -2rem;
      right: -1.5rem;
    }
  }

  /* Key problems: a bold run-in title, then a short description */
  .problems {
    display: grid;
    gap: var(--space-5) var(--space-7);
    padding: 0;
    list-style: none;
  }

  .problems li {
    max-width: 38ch;
  }

  .problems strong {
    font-weight: var(--weight-bold);
    color: var(--teal);
  }

  @media (min-width: 40rem) {
    .problems {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .problems {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Selected work: cards sit on paper here, so they take the mist tone */
  .work-grid {
    display: grid;
    gap: var(--space-5);
    --card-bg: var(--mist);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Anchored sections clear the top of the window when jumped to */
  #work,
  #contact {
    scroll-margin-top: var(--space-4);
  }
</style>
