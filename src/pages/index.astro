---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Pillars from '../components/Pillars.astro';
import WorkCard from '../components/WorkCard.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { url } from '../utils/url';

// Placeholder illustrations. Replaced with the real paintings in milestone 5.
import Leaf from '../assets/illustrations/leaf.svg';
import Petal from '../assets/illustrations/petal.svg';
import Burst from '../assets/illustrations/burst.svg';
import Squiggle from '../assets/illustrations/squiggle.svg';
import Dots from '../assets/illustrations/dots.svg';

// Draft copy. To be revised in a full copy pass.
const problems = [
  {
    title: 'Building operations from the ground up.',
    body: "Setting up an ops practice where there wasn't one, starting with listening, then a backlog leadership can see and steer.",
  },
  {
    title: 'Growth and career frameworks.',
    body: 'Making competencies clear enough that people use them between review cycles, and managers can have honest conversations about progression.',
  },
  {
    title: 'Performance and feedback systems.',
    body: 'Connecting the people who hold different pieces of the picture, so decisions about performance happen in weeks instead of months.',
  },
  {
    title: 'Quality standards teams actually use.',
    body: 'Turning a shared definition of good work into checkpoints that fit the way projects already run.',
  },
  {
    title: 'AI adoption and learning programs.',
    body: 'Helping people at very different starting points find practical, everyday uses for AI, across time zones and busy schedules.',
  },
  {
    title: 'Team connection on distributed teams.',
    body: 'Rebuilding the rituals that make a remote team feel like a team, especially after a hard stretch like layoffs.',
  },
  {
    title: 'Leadership operating rhythm.',
    body: 'Restructuring leadership meetings so team feedback and priorities turn into decisions, not another round of discussion.',
  },
  {
    title: 'Cross-functional handoffs.',
    body: 'Improving the rituals between design, engineering, and product so work moves between disciplines with less friction.',
  },
  {
    title: 'Making the case for change.',
    body: 'Pulling together the data, the stories, and the investment case leaders need to commit to fixing something.',
  },
];

const pillars = [
  {
    title: 'Turning ambiguity into programs',
    body: "I take organizational problems that don't have a shape yet and turn them into structured, measurable initiatives. I start with the data, build the case, and design toward outcomes I can track.",
    icon: Burst,
  },
  {
    title: 'Partnering with leadership',
    body: 'I work top-down with executives to align on priorities and build the investment case, and bottom-up with the people doing the work to find where friction actually lives.',
    icon: Petal,
  },
  {
    title: 'Closing the design to engineering gap',
    body: 'I partner with both design and engineering leadership to improve the rituals that reduce handoff friction and help disciplines work better together.',
    icon: Leaf,
  },
];

const work = (await getCollection('work'))
  .filter((entry) => entry.data.onHomepage)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Veronica Romero: design operations and people experience leader"
  description="I help organizations build the systems and processes that let their people do their best work."
  footerContact={false}
>
  <section class="section section--teal hero" aria-labelledby="hero-name">
    <Leaf class="hero__art hero__art--leaf" aria-hidden="true" />
    <Petal class="hero__art hero__art--petal" aria-hidden="true" />
    <Dots class="hero__art hero__art--dots" aria-hidden="true" />
    <div class="container flow hero__inner" style="--flow-space: var(--space-6)">
      <hgroup class="hero__title">
        <h1 id="hero-name">Veronica Romero</h1>
        <p class="hero__role">Design operations and people experience leader</p>
      </hgroup>
      <p class="hero__statement">
        I help organizations build the systems and processes that let their people do their
        best work.
      </p>
      <p class="hero__more"><a href={url('about/')}>More about me <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="problems-heading">
    <div class="container flow" style="--flow-space: var(--space-7)">
      <h2 id="problems-heading">Problems I help organizations solve</h2>
      <ul class="problems" role="list">
        {
          problems.map((problem) => (
            <li>
              <strong>{problem.title}</strong> {problem.body}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="work" class="section section--paper" aria-labelledby="work-heading">
    <div class="container flow" style="--flow-space: var(--space-6)">
      <h2 id="work-heading">Selected work</h2>
      <div class="work-grid">
        {
          work.map((entry) => (
            <WorkCard
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              org={entry.data.org}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--blue break" aria-labelledby="how-heading">
    <Squiggle class="break__art" aria-hidden="true" />
    <div class="container flow" style="--flow-space: var(--space-7)">
      <h2 id="how-heading">How I work</h2>
      <Pillars pillars={pillars} />
    </div>
  </section>

  <section id="contact" class="section section--mist" aria-labelledby="contact-heading">
    <div class="container flow" style="--flow-space: var(--space-5)">
      <h2 id="contact-heading">Let's talk</h2>
      <p class="lede">
        If you'd like to work together, or you're wrestling with something on your team and
        want a second brain on it, I'd love to chat. Email is the best way to reach me.
      </p>
      <ContactLinks />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-8), 12vw, 10rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  /* Name very big, with the subtitle tucked in close underneath */
  .hero__title {
    display: grid;
    gap: var(--space-2);
  }

  .hero__title h1 {
    font-size: clamp(3rem, 0.6rem + 8.3vw, 7.5rem);
    line-height: 1;
  }

  .hero__role {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: var(--weight-medium);
    color: var(--mist);
  }

  .hero__more {
    font-weight: var(--weight-medium);
    --link-color: var(--white);
  }

  .hero__statement {
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 30ch;
  }

  /* Illustrations sit at the edges, slightly off the page, as if placed by hand */
  .hero :global(.hero__art) {
    position: absolute;
    pointer-events: none;
  }

  .hero :global(.hero__art--leaf) {
    width: clamp(5rem, 12vw, 9rem);
    top: -1.5rem;
    right: 6%;
    transform: rotate(24deg);
  }

  .hero :global(.hero__art--petal) {
    width: clamp(6rem, 14vw, 11rem);
    bottom: -2.5rem;
    right: -1.5rem;
    transform: rotate(-12deg);
  }

  .hero :global(.hero__art--dots) {
    width: clamp(5rem, 10vw, 8rem);
    bottom: 1.5rem;
    right: 28%;
  }

  /* On phones, keep only the corner pieces, small enough to stay clear of the text */
  @media (max-width: 40rem) {
    .hero :global(.hero__art--dots) {
      display: none;
    }

    .hero :global(.hero__art--leaf) {
      width: 3.5rem;
      top: -1rem;
      right: 1rem;
    }

    .hero :global(.hero__art--petal) {
      width: 5rem;
      bottom: -2rem;
      right: -1.5rem;
    }
  }

  /* Section break illustration */
  .break {
    position: relative;
    overflow: hidden;
  }

  .break :global(.break__art) {
    position: absolute;
    top: var(--space-6);
    right: -2rem;
    width: clamp(8rem, 18vw, 14rem);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .break :global(.break__art) {
      top: var(--space-4);
      width: 6rem;
      opacity: 0.8;
    }
  }

  /* Key problems: a bold run-in title, then a short description */
  .problems {
    display: grid;
    gap: var(--space-5) var(--space-7);
    padding: 0;
    list-style: none;
  }

  .problems li {
    max-width: 38ch;
  }

  .problems strong {
    font-weight: var(--weight-bold);
    color: var(--teal);
  }

  @media (min-width: 40rem) {
    .problems {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .problems {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Selected work: cards sit on paper here, so they take the mist tone */
  .work-grid {
    display: grid;
    gap: var(--space-5);
    --card-bg: var(--mist);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Anchored sections clear the top of the window when jumped to */
  #work,
  #contact {
    scroll-margin-top: var(--space-4);
  }
</style>
