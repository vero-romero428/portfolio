---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Pillars from '../components/Pillars.astro';
import WorkCard from '../components/WorkCard.astro';
import { url } from '../utils/url';

// Placeholder illustrations. Replaced with the real paintings in milestone 5.
import Leaf from '../assets/illustrations/leaf.svg';
import Petal from '../assets/illustrations/petal.svg';
import Burst from '../assets/illustrations/burst.svg';
import Squiggle from '../assets/illustrations/squiggle.svg';
import Dots from '../assets/illustrations/dots.svg';

const roles = [
  {
    org: 'Lightspeed Commerce',
    dates: '2026',
    description:
      'Senior Design Operations for a 140-person design team across three verticals, focused on helping designers and researchers adopt AI well.',
  },
  {
    org: 'Metalab',
    dates: '2023 to 2026',
    description:
      'Built the DesignOps practice from scratch and expanded into department operations across the org.',
  },
  {
    org: 'Deloitte Digital',
    dates: '2021 to 2023',
    description:
      'Group Experience Design Manager, navigating a large, complex organization after acquisition.',
  },
  {
    org: 'TWG',
    dates: '2014 to 2021',
    description:
      'Grew from product designer into design leadership, eventually managing a 30-person team.',
  },
];

const pillars = [
  {
    title: 'Turning ambiguity into programs',
    body: "I take organizational problems that don't have a shape yet and turn them into structured, measurable initiatives. I start with the data, build the case, and design toward outcomes I can track.",
    icon: Burst,
  },
  {
    title: 'Partnering with leadership',
    body: 'I work top-down with executives to align on priorities and build the investment case, and bottom-up with the people doing the work to find where friction actually lives.',
    icon: Petal,
  },
  {
    title: 'Closing the design to engineering gap',
    body: 'I partner with both design and engineering leadership to improve the rituals that reduce handoff friction and help disciplines work better together.',
    icon: Leaf,
  },
];

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Veronica Romero: design operations and people experience leader"
  description="Building the systems and conditions where teams can do their best work."
  footerContact={false}
>
  <section class="section section--teal hero" aria-labelledby="hero-name">
    <Leaf class="hero__art hero__art--leaf" aria-hidden="true" />
    <Petal class="hero__art hero__art--petal" aria-hidden="true" />
    <Dots class="hero__art hero__art--dots" aria-hidden="true" />
    <div class="container flow hero__inner" style="--flow-space: var(--space-5)">
      <h1 id="hero-name">Veronica Romero</h1>
      <p class="hero__role">Design operations and people experience leader</p>
      <p class="hero__statement">
        Building the systems and conditions where teams can do their best work.
      </p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="timeline-heading">
    <div class="container flow" style="--flow-space: var(--space-6)">
      <h2 id="timeline-heading">Where I've worked</h2>
      <Timeline roles={roles} />
    </div>
  </section>

  <section class="section section--blue break" aria-labelledby="how-heading">
    <Squiggle class="break__art" aria-hidden="true" />
    <div class="container flow" style="--flow-space: var(--space-7)">
      <h2 id="how-heading">How I work</h2>
      <Pillars pillars={pillars} />
    </div>
  </section>

  <section class="section section--mist" aria-labelledby="work-heading">
    <div class="container flow" style="--flow-space: var(--space-6)">
      <h2 id="work-heading">Selected work</h2>
      <div class="work-grid">
        {
          work.map((entry) => (
            <WorkCard
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              org={entry.data.org}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="contact-heading">
    <div class="container flow" style="--flow-space: var(--space-5)">
      <h2 id="contact-heading">Get in touch</h2>
      <ul class="contact-links" role="list">
        <li><span class="todo">[Email]</span></li>
        <li><span class="todo">[LinkedIn]</span></li>
        <li><a href={url('resume.pdf')}>Download my resume</a></li>
      </ul>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-8), 12vw, 10rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
  }

  .hero__role {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--mist);
  }

  .hero__statement {
    font-family: var(--font-serif);
    font-weight: var(--weight-light);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    max-width: 24ch;
  }

  /* Illustrations sit at the edges, slightly off the page, as if placed by hand */
  .hero :global(.hero__art) {
    position: absolute;
    pointer-events: none;
  }

  .hero :global(.hero__art--leaf) {
    width: clamp(5rem, 12vw, 9rem);
    top: -1.5rem;
    right: 6%;
    transform: rotate(24deg);
  }

  .hero :global(.hero__art--petal) {
    width: clamp(6rem, 14vw, 11rem);
    bottom: -2.5rem;
    right: -1.5rem;
    transform: rotate(-12deg);
  }

  .hero :global(.hero__art--dots) {
    width: clamp(5rem, 10vw, 8rem);
    bottom: 1.5rem;
    right: 28%;
  }

  /* On phones, keep only the corner pieces, small enough to stay clear of the text */
  @media (max-width: 40rem) {
    .hero :global(.hero__art--dots) {
      display: none;
    }

    .hero :global(.hero__art--leaf) {
      width: 3.5rem;
      top: -1rem;
      right: 1rem;
    }

    .hero :global(.hero__art--petal) {
      width: 5rem;
      bottom: -2rem;
      right: -1.5rem;
    }
  }

  /* Section break illustration */
  .break {
    position: relative;
    overflow: hidden;
  }

  .break :global(.break__art) {
    position: absolute;
    top: var(--space-6);
    right: -2rem;
    width: clamp(8rem, 18vw, 14rem);
    transform: rotate(-8deg);
    pointer-events: none;
  }

  @media (max-width: 40rem) {
    .break :global(.break__art) {
      top: var(--space-4);
      width: 6rem;
      opacity: 0.8;
    }
  }

  /* Selected work */
  .work-grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Contact */
  .contact-links {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
    font-size: var(--text-lg);
  }
</style>
