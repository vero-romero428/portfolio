---
import { EMAIL, LINKEDIN_URL } from '../utils/contact';
import LinkedInIcon from './LinkedInIcon.astro';
---

<ul class="contact-links" role="list">
  <li>
    {EMAIL ? <a href={`mailto:${EMAIL}`}>{EMAIL}</a> : <span class="todo">[Email]</span>}
  </li>
  <li>
    <a class="contact-links__linkedin" href={LINKEDIN_URL}>
      <LinkedInIcon />
      <span>LinkedIn</span>
    </a>
  </li>
</ul>

<style>
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding: 0;
    list-style: none;
    font-weight: var(--weight-medium);
  }

  .contact-links__linkedin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
