---
import ContactLinks from './ContactLinks.astro';

interface Props {
  // The homepage has its own contact section, so it hides these links
  showContact?: boolean;
}

const { showContact = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer section--teal">
  <div class="container site-footer__inner">
    {showContact && <ContactLinks />}
    <p class="site-footer__credit">&copy; {year} Veronica Romero</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-7);
    --link-color: var(--white);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-5);
  }

  .site-footer__credit {
    font-size: var(--text-sm);
    color: var(--mist);
  }
</style>
